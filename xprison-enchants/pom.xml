<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.nakilex</groupId>
    <artifactId>xprison-enchants</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!--
            X-Prison ships its own API classes (and a shaded gson/exp4j) inside the plugin jar.
            The jar is not redistributable, so lib/ is gitignored - copy X-Prison.jar and
            helper.jar from the server's plugins/ folder before building.
        -->
        <dependency>
            <groupId>dev.drawethree</groupId>
            <artifactId>x-prison</artifactId>
            <version>2026.3.7.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/X-Prison.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>me.lucko</groupId>
            <artifactId>helper</artifactId>
            <version>5.6.14</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/helper.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>XPrisonEnchants</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <X-Prison-Addon-Class>me.nakilex.xprisonenchants.XPrisonEnchantsAddon</X-Prison-Addon-Class>
                            <X-Prison-Addon-Name>XPrisonEnchants</X-Prison-Addon-Name>
                            <X-Prison-Addon-Version>${project.version}</X-Prison-Addon-Version>
                            <X-Prison-Addon-Author>Nakilex</X-Prison-Addon-Author>
                            <X-Prison-Addon-Description>Cinematic area enchants: Tornado, Black Hole, Meteor Shower, Acid Rain.</X-Prison-Addon-Description>
                            <X-Prison-Min-Version>2026.3.0.0</X-Prison-Min-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
